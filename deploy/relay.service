[Unit]
Description=ASA Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=asa
ExecStart=/opt/asa/asa relay serve 9000 /var/lib/asa/relay-state.json
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/asa

[Install]
WantedBy=multi-user.target
